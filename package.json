{
  "name": "boro-chess",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build:console": "pnpm --filter @boro-chess/console build",
    "build:web": "pnpm --filter @boro-chess/web build",
    "start": "pnpm --filter @boro-chess/console start",
    "dev:web": "pnpm --filter @boro-chess/web dev",
    "start:debug": "pnpm --filter @boro-chess/console start:debug",
    "start:dist": "pnpm --filter @boro-chess/console start:dist",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:coverage:domain": "jest --coverage --collectCoverageFrom='src/*/domain/**/*.ts' --collectCoverageFrom='!**/*.spec.ts'",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --runInBand --watchAll=false",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.17.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
